# Copy to server/.env and fill in. server/.env is git-ignored — never commit it.
# Leave these blank/absent and the app runs exactly as before (Sheets sync is a no-op).

# JWT signing secret. Change this for any real deployment.
JWT_SECRET=ranch-hand-dev-secret-change-me

# --- Google Sheets CRM mirror (optional) ------------------------------------
# Mirrors each new signup into a spreadsheet. SQLite stays the source of truth.
#
# Setup:
#  1. Google Cloud Console -> create/select a project.
#  2. APIs & Services -> Library -> enable "Google Sheets API".
#  3. APIs & Services -> Credentials -> Create credentials -> Service account.
#  4. On the service account -> Keys -> Add key -> Create new key -> JSON.
#  5. Create a Google Sheet. Share it with the service account's email
#     (the client_email in the JSON) with **Editor** access.
#  6. Copy values from the JSON into the vars below.

# Spreadsheet ID — from the URL:
#   https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEETS_ID=

# "client_email" from the service account JSON.
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# "private_key" from the JSON. Keep it on ONE line, wrapped in double quotes,
# with the literal \n sequences left exactly as they appear in the JSON.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# Tab name within the spreadsheet. Created automatically if it doesn't exist.
GOOGLE_SHEETS_TAB=Signups
